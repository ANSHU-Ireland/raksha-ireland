{
  "name": "raksha-ireland-backend",
  "version": "1.0.0",
  "description": "Backend API for Raksha Ireland emergency alert system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "node scripts/build.js",
    "docker:build": "docker build -t raksha-ireland-backend .",
    "docker:run": "docker run -p 3000:3000 raksha-ireland-backend"
  },
  "keywords": [
    "emergency",
    "alerts",
    "location",
    "safety",
    "ireland",
    "immigrants"
  ],
  "author": "Raksha Ireland Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.86.2",
    "axios": "^1.5.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.3.1",
    "firebase-admin": "^11.10.1",
    "helmet": "^7.0.0",
    "http-parser": "^1.0.3",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^2.5.1",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.4",
    "eslint": "^8.47.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.1",
    "husky": "^8.0.3",
    "jest": "^29.6.4",
    "lint-staged": "^14.0.1",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raksha-ireland/backend.git"
  },
  "bugs": {
    "url": "https://github.com/raksha-ireland/backend/issues"
  },
  "homepage": "https://github.com/raksha-ireland/backend#readme"
}
