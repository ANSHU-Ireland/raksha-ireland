# Environment Configuration for Raksha Ireland Backend

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=raksha_user
DB_PASSWORD=raksha_password
DB_NAME=raksha_ireland

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Configuration
FIREBASE_PROJECT_ID=raksha-ireland-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@raksha-ireland-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@raksha-ireland.org

# AWS Configuration (for file uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=raksha-ireland-documents

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379

# Internal API Key (for service-to-service communication)
INTERNAL_API_KEY=your-internal-api-key-change-this

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
EMERGENCY_RATE_LIMIT_MAX=2

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log