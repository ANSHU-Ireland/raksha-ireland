# Mobile App Environment Configuration
# Copy this file to .env and update with your actual values

# API Gateway URL (will be updated after backend deployment)
EXPO_PUBLIC_API_URL=https://your-api-gateway-url.amazonaws.com

# AWS Configuration
EXPO_PUBLIC_AWS_REGION=eu-west-1

# Expo Configuration
EXPO_PUBLIC_APP_NAME=RAKSHA Ireland
EXPO_PUBLIC_APP_VERSION=1.0.0

# Development Settings
EXPO_PUBLIC_DEBUG_MODE=true

# Supabase (mobile: public anon key only)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Enable direct Supabase reads/writes from the app
EXPO_PUBLIC_USE_SUPABASE=false